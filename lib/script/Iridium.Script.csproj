<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Version>3.0.0.8061</Version>
		<Authors>Philippe Leybaert</Authors>
		<PackageTags>iridium scripting c# expression templates mobile xamarin maui</PackageTags>
		<RepositoryUrl>https://github.com/activa/iridium-script</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<Description>Portable and lightweight C# library for scripting, expression evaluation and template rendering. Compatible with mobile platforms where Reflection.Emit is not supported.</Description>
		<PackageId>iridium.script</PackageId>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="iridium.convert" Version="2.8.0.7281" />
	  <PackageReference Include="PolySharp" Version="1.16.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
