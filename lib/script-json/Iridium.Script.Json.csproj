<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Version>2.5.0.7211</Version>
		<Authors>Philippe Leybaert</Authors>
		<PackageTags>iridium scripting c# expression templates json</PackageTags>
		<RepositoryUrl>https://github.com/activa/iridium-script</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<Description>Iridium.Json plugin for Iridium.Script</Description>
		<PackageId>iridium.script.json</PackageId>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\script\Iridium.Script.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="iridium.json" Version="3.0.4.8062" />
		<PackageReference Include="PolySharp" Version="1.16.0" />
	</ItemGroup>

</Project>
